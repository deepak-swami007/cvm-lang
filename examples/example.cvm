// ================================================
// CVM++ Primitive Type Demo
// ================================================

char letter = 'A';
print letter;

int version = 2;
print version;

double value = 3.5;
print value;

for (int loopCount = 1; loopCount <= 5; loopCount = loopCount + 1) {
    print loopCount;
}

long sum = 0;
int n = 1;
for (; n <= 10; n = n + 1) {
    sum = sum + n;
}
print sum;

int x = 5;
if (x > 0 && x < 10) {
    print x;
}

bool flag = false;
if (flag || x == 5) {
    print 1;
}

bool safe = true;
if (safe || x > 100) {
    print 2;
}

for (int breakIndex = 1; breakIndex <= 10; breakIndex = breakIndex + 1) {
    if (breakIndex > 3) {
        break;
    }
    print breakIndex;
}

for (int continueIndex = 1; continueIndex <= 6; continueIndex = continueIndex + 1) {
    if (continueIndex % 2 == 0) {
        continue;
    }
    print continueIndex;
}

int val = 10;
val += 5;
print val;

val -= 3;
print val;

val *= 2;
print val;

val /= 4;
print val;

auto inferred = 'Z';
print inferred;
